// DINKMASTER schema — pickleball arena: players, queue, courts, matches, partnerships.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A pickleball arena — an isolated session of players, courts, and matches
/// owned by one User. All arena data is scoped by `arenaId`.
model Arena {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  players      Player[]
  courts       Court[]
  matches      Match[]
  partnerships Partnership[]

  @@index([ownerId])
}

/// A registered player. `queueOrder` is the position in the paddle rack
/// (null when the player is on a court or otherwise not waiting).
model Player {
  id          String   @id @default(cuid())
  arenaId     String
  name        String
  gamesPlayed Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)
  queueOrder  Int? // null = not in queue; ascending = rack order
  waitRounds  Int      @default(0) // consecutive rounds spent waiting (fairness)
  gamesOffset Int      @default(0) // games credited at join (group avg) so latecomers slot in as peers, not catch-up


  createdAt   DateTime @default(now())

  arena      Arena       @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  courtSlots CourtSlot[]

  @@index([arenaId])
  @@index([queueOrder])
}

/// A physical court. `position` orders the courts in the UI.
model Court {
  id        String   @id @default(cuid())
  arenaId   String
  name      String
  status    String   @default("vacant") // "vacant" | "playing"
  position  Int
  createdAt DateTime @default(now())

  arena Arena       @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  slots CourtSlot[]

  @@index([arenaId])
  @@index([position])
}

/// One player assigned to a team on a court during a live match.
model CourtSlot {
  id       String @id @default(cuid())
  courtId  String
  playerId String
  team     Int // 1 or 2

  court  Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([courtId, playerId])
  @@unique([playerId]) // a player can only be on one court at a time
  @@index([courtId])
}

/// A finished match. Player names are snapshotted so history survives
/// player deletion.
model Match {
  id        String   @id @default(cuid())
  arenaId   String
  courtName String
  score1    Int
  score2    Int
  createdAt DateTime @default(now())

  arena   Arena         @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  players MatchPlayer[]

  @@index([arenaId])
  @@index([createdAt])
}

/// A player's participation in a finished match (snapshot, no FK to Player).
model MatchPlayer {
  id         String @id @default(cuid())
  matchId    String
  playerId   String // historical reference only, not a foreign key
  playerName String
  team       Int

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

/// Cumulative count of how often two players have been partnered.
/// Stored canonically with playerA < playerB to keep one row per pair.
model Partnership {
  id      String @id @default(cuid())
  arenaId String
  playerA String
  playerB String
  count   Int    @default(0)

  arena Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@unique([playerA, playerB])
  @@index([arenaId])
}

// --- Auth (Better Auth) -------------------------------------------------
// These four models are the schema Better Auth expects. Field names and
// types must match Better Auth's defaults; Better Auth generates the `id`
// values itself (no @default here). See https://www.better-auth.com.

/// An authenticated account. Owns arenas and (in a later phase) can be
/// linked to a Player so people see their own match history and scores.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  arenas   Arena[]
}

/// A signed-in session (cookie-backed).
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A credential or OAuth account attached to a user. Email+password
/// auth stores the bcrypt-style hash in `password`.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Short-lived verification tokens (email verification, password reset).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
