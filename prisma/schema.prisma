// DINKMASTER schema — pickleball arena: players, queue, courts, matches, partnerships.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A pickleball arena — an isolated session of players, courts, and matches
/// owned by one User. All arena data is scoped by `arenaId`.
model Arena {
  id          String   @id @default(cuid())
  name        String
  description String? // optional, manager-set blurb (surfacing on the arena view is tracked in #33)
  ownerId     String
  createdAt   DateTime @default(now())

  // Recurring play schedule — powers the schedule-aware weekly leaderboard
  // ("This Week" / Player of the Week). `scheduleDays` holds weekday numbers
  // (0 = Sunday … 6 = Saturday, matching JS `Date.getDay()`); empty is treated
  // as "every day" by the leaderboard's day filter, so a partial config never
  // produces an empty board (see `countOffScheduleGames` below for the toggle
  // that controls whether off-schedule games are excluded at all).
  // `scheduleStart`/`scheduleEnd` are local "HH:MM" 24h strings (display only,
  // not used to clip matches). `timezone` is an IANA zone used to compute the
  // Mon–Sun week boundary; defaults to the project's primary locale.
  scheduleDays  Int[]   @default([])
  scheduleStart String?
  scheduleEnd   String?
  timezone      String  @default("Asia/Manila")

  // Per-arena matchmaking thresholds (Phase 9). Defaults match the shared
  // constants in `src/lib/matchmaking.js`, so existing arenas are unchanged.
  // A waiting player is "protected" (⏳ badge, always ahead of fresh players)
  // at `starveThreshold` rounds and "emergency" (strictly longest-first) at
  // `emergencyWait`; `emergencyWait` must be ≥ `starveThreshold`.
  starveThreshold Int @default(2)
  emergencyWait   Int @default(4)

  // When on, the Skip action promotes the paddle to a "Next in Line" band
  // (above emergency) so they jump to the top on the next auto-mix, instead
  // of going to the back of the rack with `waitRounds` reset to 0. Off
  // preserves the original behaviour (de-prioritize on skip). See
  // `skipPlayer` in `src/app/actions.js`.
  skipRestoresPriority Boolean @default(true)

  // When on, a manager skipping an on-deck paddle opens a replacement
  // picker (modal listing waiting paddles) and the chosen player fills the
  // freed on-deck slot. When off, the first waiting player auto-fills
  // (existing behavior). Non-managers never see the picker even when this
  // is on — self-rest is always auto-pick.
  skipPickReplacement Boolean @default(true)

  // Per-arena match + leaderboard defaults (Phase 9b). Defaults preserve the
  // prior hardcoded behaviour, so existing arenas play exactly as before.
  // `targetScore` seeds the score-modal inputs; `autoMixDefault` seeds the
  // "Auto-mix" toggle; `leaderboardSize` caps the **This Week** board (and
  // the per-player rank visible on /profile); `countOffScheduleGames` decides
  // whether games played outside the schedule's days/times still count
  // toward the weekly leaderboard.
  targetScore           Int     @default(11)
  autoMixDefault        Boolean @default(true)
  leaderboardSize       Int     @default(5)
  countOffScheduleGames Boolean @default(true)

  // When on, the arena surfaces the "Partnership Matrix" tab (a pairing-count
  // grid). Hidden by default — it's an advanced/diagnostic view — and opt-in
  // per arena from Settings → Match Defaults. Visibility is arena-wide, not
  // per-viewer.
  showPartnershipMatrix Boolean @default(false)

  // Per-arena session prep state (Phase 10a). `lastSessionResetAt` records
  // when the rack/partnerships were last cleared via `prepareNextSession`,
  // so the manager prep banner can surface "last reset N days ago" and the
  // dismissal key is stable per session. `autoResetOnSession` controls
  // whether the session boundary auto-empties the rack; the column default
  // is `true` for NEW arenas but the migration backfills existing rows to
  // `false`, making this opt-in for arenas already in use so the perpetual-
  // rack behaviour they rely on doesn't change without a manager flipping
  // it on.
  lastSessionResetAt DateTime?
  autoResetOnSession Boolean   @default(true)

  // Per-arena Activity settings. `rsvpEnabled` off hides every RSVP affordance
  // for clubs that run pure walk-in — activities still record standings and
  // match logs, they just don't ask who's coming. `defaultActivityCapacity`
  // seeds new SCHEDULE activities as they materialize (null = uncapped) and is
  // only a default: editing one activity's capacity never touches the others.
  // `activityHorizonDays` is how far ahead `ensureUpcomingActivities` fills.
  rsvpEnabled             Boolean @default(true)
  defaultActivityCapacity Int?
  activityHorizonDays     Int     @default(28)

  // Advisory offline hold (Phase 4 of offline session mode). Set by
  // `declareOfflineHold` when a manager starts running the board offline
  // while still reachable; cleared by `releaseOfflineHold` and inside the
  // `syncOfflineEvents` transaction. Surfaced through getState so other
  // viewers see a soft "X is running the board offline" warning. NEVER
  // enforced: a truly offline device can't declare it, and the sync
  // fingerprint check is what protects correctness. Consumers must treat a
  // stale `offlineHeldAt` as expired (a dead device never releases).
  offlineHolderLabel String?
  offlineHeldAt      DateTime?

  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  players      Player[]
  courts       Court[]
  matches      Match[]
  partnerships Partnership[]
  memberships  ArenaMembership[]
  joinRequests JoinRequest[]
  linkRequests LinkRequest[]
  invites      ArenaInvite[]
  activities   Activity[]

  @@index([ownerId])
}

/// One concrete occurrence of the arena's recurring schedule — "Tuesday night,
/// Jul 14". The schedule columns on `Arena` describe a *rule*; `src/lib/sessions.js`
/// turns that rule into `{start, end}` windows; an Activity is one of those windows
/// MATERIALIZED, so it can own records that a recomputed window never could:
/// which matches were played, who showed up, and who partnered with whom.
///
/// Rows are created idempotently by `ensureUpcomingActivities`
/// (`src/lib/activities-server.js`) — a lazy upsert on `@@unique([arenaId, startsAt])`
/// called from page loads, so no cron is needed. Managers can also create one-off
/// `MANUAL` activities that don't correspond to any scheduled day.
///
/// "Current" is `status = LIVE`, not a pointer on Arena: a denormalized pointer can
/// drift, and every board write already serializes on the `lockQueue` advisory lock,
/// so `startActivity` can't race another into a second LIVE row for the same arena.
model Activity {
  id       String   @id @default(cuid())
  arenaId  String
  /// null → derived for display from `startsAt` + `timezone` (see `activityTitle`).
  title    String?
  startsAt DateTime
  endsAt   DateTime
  /// Snapshot of the arena's timezone when the activity was created. Deliberately
  /// NOT read through to `Arena.timezone`: a manager moving the club to a new zone
  /// must not retroactively shift the local dates of finished activities.
  timezone String

  status ActivityStatus @default(SCHEDULED)
  source ActivitySource @default(SCHEDULE)

  /// null = uncapped. When set, RSVPs past this count land on the waitlist.
  capacity Int?
  notes    String?

  /// Set when `startActivity` opens this one (rack prepped, matches start counting).
  openedAt  DateTime?
  /// Set when the next activity opens. A closed activity is frozen history.
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  arena        Arena              @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  attendees    ActivityAttendee[]
  matches      Match[]
  partnerships Partnership[]

  /// Makes materialization idempotent — re-running `ensureUpcomingActivities`
  /// for the same window upserts instead of duplicating.
  @@unique([arenaId, startsAt])
  @@index([arenaId, status])
  @@index([arenaId, startsAt])
}

/// Who is coming to an activity. This is the first time attendance is recorded
/// anywhere in the app: before Activities, `Player.queueOrder != null` was the only
/// signal that someone showed up, and `startActivity` nulls it for everyone.
///
/// `playerId` is null for a member who RSVP'd but has no `Player` row in the arena
/// yet; `userId` is null for a manager-added walk-in. `displayName` is snapshotted
/// for the same reason `MatchPlayer` snapshots names — the list must survive the
/// player row being removed.
model ActivityAttendee {
  id          String  @id @default(cuid())
  activityId  String
  playerId    String?
  userId      String?
  displayName String

  status      AttendeeStatus @default(GOING)
  /// Waitlist ordering — first-come-first-serve, so a drop promotes the lowest
  /// position. Null for any status other than WAITLIST.
  position    Int?
  checkedInAt DateTime?
  createdAt   DateTime       @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, playerId])
  @@unique([activityId, userId])
  @@index([activityId, status])
}

/// SCHEDULED → LIVE → COMPLETED is the happy path. CANCELLED is a manager calling
/// off a night that was already materialized; it stays in the list, greyed out,
/// rather than vanishing (players may already have RSVP'd).
enum ActivityStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

/// SCHEDULE rows are generated from the arena's recurring schedule and are
/// re-derivable; MANUAL rows are one-offs a manager typed in and must never be
/// garbage-collected by the materializer.
enum ActivitySource {
  SCHEDULE
  MANUAL
}

enum AttendeeStatus {
  GOING
  WAITLIST
  DECLINED
  CHECKED_IN
  NO_SHOW
}

/// A pending request to join an arena. A row's existence means the request is
/// pending; it is deleted when an owner/organizer accepts (becoming an
/// `ArenaMembership`) or rejects it.
model JoinRequest {
  id        String   @id @default(cuid())
  arenaId   String
  userId    String
  createdAt DateTime @default(now())

  arena Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([arenaId, userId])
  @@index([arenaId])
  @@index([userId])
}

/// A pending request from an arena member to be linked to an existing
/// walk-in (orphan) Player row in that arena. A row's existence means the
/// request is pending; it is deleted when an owner/organizer approves it
/// (merging the member into the orphan player via `linkPlayerToMember`),
/// rejects it, or the requester cancels it.
model LinkRequest {
  id        String   @id @default(cuid())
  arenaId   String
  userId    String // the requesting member
  playerId  String // the orphan walk-in Player they claim
  createdAt DateTime @default(now())

  arena  Arena  @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Composite FK on (arenaId, playerId) so the DB rejects a request whose
  // player belongs to a different arena than the request itself. Target is
  // Player's `@@unique([arenaId, id])`, which exists solely to make this
  // composite reference valid.
  player Player @relation(fields: [arenaId, playerId], references: [arenaId, id], onDelete: Cascade)

  @@unique([arenaId, userId]) // one open request per member per arena
  @@unique([arenaId, playerId]) // one open request per orphan per arena
  @@index([arenaId])
}

/// A member's role within an arena. Enforced at the database level so an
/// invalid value can never be persisted and break authorization checks.
enum ArenaRole {
  OWNER
  ORGANIZER
  MEMBER
}

/// What happens when someone redeems an arena invite link.
/// - AUTO_JOIN — they become a MEMBER + queued player immediately, no approval.
/// - APPROVAL  — a JoinRequest is created for an owner/organizer to approve.
enum InviteMode {
  AUTO_JOIN
  APPROVAL
}

/// A manager-issued invite link to an arena. `code` is a random, unguessable
/// token (NOT the public arena id) carried in `/join/<code>`; auto-join links
/// rely on it being unguessable. Multiple invites can be active per arena
/// (e.g. one AUTO_JOIN and one APPROVAL link at once). Revoking sets
/// `active=false` rather than deleting, so a redeemed/expired link 404s
/// cleanly while the row survives for auditing.
model ArenaInvite {
  id        String     @id @default(cuid())
  arenaId   String
  code      String     @unique
  mode      InviteMode @default(APPROVAL)
  createdBy String // userId of the owner/organizer who created it
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  arena   Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  // Cascade on creator deletion is intentional: if the manager who issued a
  // link loses their account, their live links die with them rather than
  // letting a removed person keep funnelling people in.
  creator User  @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  // `code` is already uniquely indexed by `@unique`; no separate @@index needed.
  @@index([arenaId])
}

/// A user's role within an arena. The owner is tracked canonically by
/// `Arena.ownerId`; their membership row mirrors it with role OWNER and is
/// kept in sync on ownership transfer.
model ArenaMembership {
  id        String    @id @default(cuid())
  arenaId   String
  userId    String
  role      ArenaRole
  createdAt DateTime  @default(now())

  arena Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([arenaId, userId])
  @@index([arenaId])
  @@index([userId])
}

/// A player on an arena's rack. `queueOrder` is the position in the paddle
/// rack (null when the player is on a court or otherwise not waiting).
/// `userId` links the player to a registered account; it is null for
/// temporary walk-in players who have no account.
model Player {
  id          String    @id @default(cuid())
  arenaId     String
  userId      String? // null = temporary walk-in player; set = a registered user
  firstName   String
  lastName    String? // optional: walk-ins often go by first name only
  gamesPlayed Int       @default(0)
  wins        Int       @default(0)
  losses      Int       @default(0)
  queueOrder  Int? // null = not in queue; ascending = rack order
  waitRounds  Int       @default(0) // consecutive rounds spent waiting (fairness)
  gamesOffset Int       @default(0) // games credited at join (group avg) so latecomers slot in as peers, not catch-up
  // When true, a Skip moved this paddle off-deck while signaling "back soon —
  // top priority on return". The next auto-mix sorts them above the emergency
  // band, then clears the flag. See `Arena.skipRestoresPriority`.
  skipBoosted Boolean   @default(false)
  rating      Int       @default(1000) // Elo skill rating (Phase 6); displayed DUPR-style. Per-arena.
  leftAt      DateTime? // null = active; set = the member left/was removed (row kept for history)

  createdAt DateTime @default(now())

  arena        Arena         @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  courtSlots   CourtSlot[]
  linkRequests LinkRequest[]

  @@unique([arenaId, userId]) // one linked player per user per arena (multiple NULLs allowed)
  @@unique([arenaId, id]) // target for LinkRequest's composite FK (enforces same-arena)
  @@index([arenaId])
  @@index([queueOrder])
  @@index([userId])
}

/// A physical court. `position` orders the courts in the UI.
model Court {
  id                  String   @id @default(cuid())
  arenaId             String
  name                String
  status              String   @default("vacant") // "vacant" | "playing"
  position            Int
  // Player ids whose `waitRounds` were bumped (+1) by the fill currently on this
  // court — captured at fill time so `cancelFill` can reverse the bump for
  // exactly those players, not whoever is queued at cancel time. Empty when the
  // court is vacant / was filled before this feature.
  fillBumpedPlayerIds String[] @default([])
  createdAt           DateTime @default(now())

  arena Arena       @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  slots CourtSlot[]

  @@index([arenaId])
  @@index([position])
}

/// One player assigned to a team on a court during a live match.
model CourtSlot {
  id       String @id @default(cuid())
  courtId  String
  playerId String
  team     Int // 1 or 2

  // Snapshot of the player's rack state at the moment they were stacked onto
  // this court, captured by `fillCourt`. Lets `cancelFill` restore their exact
  // original queue position and wait fairness. Null for slots created before
  // this feature (those courts simply can't be cancelled).
  prevQueueOrder Int?
  prevWaitRounds Int?

  court  Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([courtId, playerId])
  @@unique([playerId]) // a player can only be on one court at a time
  @@index([courtId])
}

/// A finished match. Player names are snapshotted so history survives
/// player deletion.
model Match {
  id        String   @id @default(cuid())
  arenaId   String
  courtName String
  score1    Int
  score2    Int
  createdAt DateTime @default(now())

  /// The activity this match belongs to — the single source of truth for
  /// per-activity records. Stamped by `applyEndMatchTx`. Nullable because a
  /// match can be finished in an arena that has no activity open (an arena with
  /// no schedule that never ran `startActivity`), and because the historical
  /// backfill is best-effort. `SetNull` not `Cascade`: deleting an activity must
  /// never destroy match history.
  activityId String?

  arena    Arena         @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  activity Activity?     @relation(fields: [activityId], references: [id], onDelete: SetNull)
  players  MatchPlayer[]

  @@index([arenaId])
  @@index([createdAt])
  /// Every session/week/activity read is `where: { arenaId, createdAt: {gte, lt} }`;
  /// the two single-column indexes above can't serve that as well as one composite.
  @@index([arenaId, createdAt])
  @@index([activityId])
}

/// A player's participation in a finished match (snapshot, no FK to Player).
model MatchPlayer {
  id              String  @id @default(cuid())
  matchId         String
  playerId        String // historical reference only, not a foreign key
  playerFirstName String
  playerLastName  String?
  team            Int

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // A player appears at most once per match (one team, one slot). Enforced so
  // a link/merge that re-points snapshot rows can't silently duplicate a
  // participant within a match.
  @@unique([matchId, playerId])
  @@index([matchId])
}

/// One synced offline session batch (idempotency ledger for
/// `syncOfflineEvents`). The id is the CLIENT-generated batch uuid: a retry
/// of a batch whose transaction committed but whose response was lost finds
/// this row and returns current state instead of double-applying. Rows are
/// small and kept for auditing (which device synced what, when).
model OfflineSyncBatch {
  id              String   @id // client-generated batch uuid
  arenaId         String
  deviceLabel     String?
  appliedEventIds String[]
  skippedCount    Int      @default(0)
  createdAt       DateTime @default(now())

  // No FK to Arena on purpose: the ledger must survive arena deletion so a
  // late retry of a batch for a deleted arena still dedupes cleanly.
  @@index([arenaId])
}

/// Count of how often two players have been partnered *within one activity*.
/// Stored canonically with playerA < playerB to keep one row per pair.
///
/// Scoped to the activity, not the arena: a fresh activity simply has no rows, so
/// tonight's mix starts unbiased with no destructive delete. Before Activities,
/// `prepareNextSession` ran `partnership.deleteMany({ where: { arenaId } })` every
/// session and the pairing history was gone for good; now it accumulates across
/// activities and stays queryable ("you've partnered with Ana 14 times over 6 nights").
///
/// `activityId` is REQUIRED so the compound unique below has no NULLs — Postgres
/// treats NULLs as distinct, which would let duplicate pair rows through, and
/// Prisma can't target a null component in an `upsert` where-clause.
model Partnership {
  id         String @id @default(cuid())
  arenaId    String
  activityId String
  playerA    String
  playerB    String
  count      Int    @default(0)

  arena    Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, playerA, playerB])
  @@index([arenaId])
  @@index([activityId])
}

// --- Auth (Better Auth) -------------------------------------------------
// These four models are the schema Better Auth expects. Field names and
// types must match Better Auth's defaults; Better Auth generates the `id`
// values itself (no @default here). See https://www.better-auth.com.

/// An authenticated account. Owns arenas and is linked to a Player in each
/// arena it plays in, so people see their own match history and scores.
model User {
  id            String    @id
  name          String // Better Auth core field; stored as "First Last"
  firstName     String
  lastName      String
  phone         String? // optional: collected under "Add more details" at sign-up
  address       String? // optional: collected under "Add more details" at sign-up
  birthday      DateTime? // optional: collected under "Add more details" at sign-up
  gender        String? // optional: collected under "Add more details" at sign-up
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  arenas         Arena[]
  memberships    ArenaMembership[]
  players        Player[]
  joinRequests   JoinRequest[]
  linkRequests   LinkRequest[]
  createdInvites ArenaInvite[]
}

/// A signed-in session (cookie-backed).
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A credential or OAuth account attached to a user. Email+password
/// auth stores the bcrypt-style hash in `password`.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Short-lived verification tokens (email verification, password reset).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
