# PostgreSQL connection string
DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/dinkmaster"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the app (used for auth callbacks/cookies)
BETTER_AUTH_URL="http://localhost:3020"

# Google social login (server-only — do NOT prefix with NEXT_PUBLIC). Enabled
# only when both vars are set. Setup + redirect URI:
# docs/social-auth-setup.md. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
