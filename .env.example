# PostgreSQL connection string
DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/dinkmaster"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the app (used for auth callbacks/cookies)
BETTER_AUTH_URL="http://localhost:3020"

# Social login (server-only — do NOT prefix with NEXT_PUBLIC). A provider is
# only enabled when both of its vars are set. Setup + redirect URIs:
# docs/social-auth-setup.md. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/<provider>
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""      # Facebook App ID
FACEBOOK_CLIENT_SECRET=""  # Facebook App Secret
